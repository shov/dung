# Claude is called through the Claude Code CLI (`claude -p`) using your subscription. No API key needed.

# Command used to start Claude Code. Leading VAR=value assignments and extra args are allowed:
# CLAUDE_CMD="CLAUDE_CONFIG_DIR=~/.claude-om claude"
CLAUDE_CMD=claude

# Set to 1 if CLAUDE_CMD is a shell alias/function: runs it via `$SHELL -ic` (slower, loads your rc file).
CLAUDE_USE_SHELL=0

# Models (CLI aliases). Through the CLI Haiku 5.5 always thinks and ends up ~3-6x slower than Sonnet at low effort.
BIBLE_MODEL=sonnet
CHUNK_MODEL=sonnet
SPRITE_MODEL=sonnet

# Optional --effort override (low|medium|high): for every call, or per kind (BIBLE, CHUNK, IMPROVISE, SPRITE).
# Defaults: bible=medium, everything else=low.
LLM_EFFORT=
# LLM_EFFORT_CHUNK=low

# Parallel chunk generations and per-call timeout
GEN_CONCURRENCY=3
LLM_TIMEOUT_MS=180000

PORT=8787
